# Local development only. Do not reuse these passwords outside this machine.

NODE_ENV=development

# portal-api (HTTP) and portal-worker (no HTTP). Database is the portal-db container.
PORTAL_HTTP_PORT=3000
PORTAL_DATABASE_URL=postgresql://portal:portal@localhost:5434/portal

# portal-worker polls the portal outbox and calls Fake Salesforce over HTTP.
# Shared outbound and reconciliation budget. Must stay at or under the fake Salesforce 100/s cap.
OUTBOUND_BUDGET_PER_SECOND=80
# Optional. Sync inspection routes are limited per portal-api process. Default 10.
# SYNC_ADMIN_REQUESTS_PER_SECOND=10
# Changes-feed page size. Reconciliation posts each event to PORTAL_WEBHOOK_URL.
RECONCILIATION_PAGE_LIMIT=100
FAKE_SALESFORCE_BASE_URL=http://localhost:3001

# fake-salesforce HTTP server. Database is the salesforce-db container.
SALESFORCE_HTTP_PORT=3001
SALESFORCE_DATABASE_URL=postgresql://salesforce:salesforce@localhost:5433/salesforce

# Local webhook delivery. Production must set a real URL, HMAC secret, and simulator token.
PORTAL_WEBHOOK_URL=http://127.0.0.1:3000/webhooks/salesforce
WEBHOOK_HMAC_SECRET=local-webhook-secret
SIMULATOR_ADMIN_TOKEN=local-simulator-token
